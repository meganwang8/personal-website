source "https://rubygems.org"

# This gem handles almost everything for GitHub Pages
gem "github-pages", group: :jekyll_plugins

# Minimal Mistakes requires this specific plugin to work
gem "jekyll-include-cache"

# If you are using the "remote theme" method (recommended for forks)
gem "jekyll-remote-theme"

# Required for Ruby 3.x compatibility
gem "webrick"